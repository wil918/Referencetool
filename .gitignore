.env
venv/
.venv-test/
__pycache__/
*.pyc
.DS_Store

# Your personal reference library -- remove these lines if you *want*
# to version-control your data (e.g. private repo as a backup).
data/
references/images/*
references/texts/*
deleted/
# Staged portfolio pages (portfolio.py) -- working files, not archive material.
portfolio/
!references/images/.gitkeep
!references/texts/.gitkeep
