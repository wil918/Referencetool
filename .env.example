# Copy this file to .env and fill in your key.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the default model used for tagging
# CLAUDE_MODEL=claude-sonnet-5

# Reaching the schedule from a phone (see the README's "Away from home").
# Leave both unset for the normal localhost-only setup.
#   ARCHIVE_HOST=0.0.0.0     bind every interface so other devices can connect
#   ARCHIVE_API_TOKEN=...     a long random string; REQUIRED once ARCHIVE_HOST
#                             is non-loopback, and entered once on the phone
# ARCHIVE_HOST=0.0.0.0
# ARCHIVE_API_TOKEN=
