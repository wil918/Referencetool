# Copy this file to .env. Every setting here is optional -- the app runs with
# none of them -- and the README's "Quick start" says what each one costs.
#
# Get a key at https://console.anthropic.com/settings/keys. Leave it empty and
# nothing is ever sent to Anthropic: references are added untagged and the
# Claude features (tagging, analysis, brief import, task estimates) are hidden.
# Paid per use -- consider a spending limit on the key.
ANTHROPIC_API_KEY=

# Turn the whole schedule (tasks, calendar, deliverables, briefs, the phone day
# view) off, leaving the archive, projects, canvas and 3D views. Nothing is
# deleted; remove the line to get it back. Accepts 1/true/yes/on.
# ARCHIVE_ONLY=1

# Never load the CLIP model (a one-off ~600 MB download that then runs locally,
# free) or the vector store. Loses semantic search, the similarity graph and the
# constellation. Only worth it on a slow connection or a small disk.
# SKIP_EMBEDDINGS=1

# Optional: override the default model used for tagging
# CLAUDE_MODEL=claude-sonnet-5

# Reaching the schedule from a phone (see the README's "Away from home").
# Leave both unset for the normal localhost-only setup.
#   ARCHIVE_HOST=0.0.0.0     bind every interface so other devices can connect
#   ARCHIVE_API_TOKEN=...     a long random string; REQUIRED once ARCHIVE_HOST
#                             is non-loopback, and entered once on the phone
# ARCHIVE_HOST=0.0.0.0
# ARCHIVE_API_TOKEN=
